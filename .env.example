# Recommended for Render: paste the exact URI from Supabase > Connect.
# For an IPv4 Render service, use the Supabase Session pooler URI (port 5432).
# Do not use the Supabase project URL (https://<project-ref>.supabase.co) as DB_HOST.
DATABASE_URL=

# Optional legacy split settings (used only when DATABASE_URL is blank).
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres

# Comma-separated origins allowed to call the API from a browser.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generate hashes locally with: python -m app.passwords
# Store the resulting JSON only as a backend secret. Never put it in frontend VITE_* variables.
MEMBER_PASSWORD_HASHES=
# Generate a long random secret for signing login sessions.
AUTH_SECRET=
# Cross-instance live chat (TLS Redis URL).
REDIS_URL=
